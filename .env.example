# Copy this to .env. Never commit .env to GitHub.
PORT=3000
HOST=0.0.0.0
# Set this using: node scripts/set-owner-password.js
PRIVATE_FILTER_PASSWORD_HASH=
# Production public domain/origin: required when behind an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://your-domain.example
# TURN relay for restrictive NATs, see README.
# TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-long-random-secret
MAX_PEERS_PER_IP=8
# REPORTS_FILE=/data/reports.jsonl
